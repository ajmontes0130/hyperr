{
  "name": "Review",
  "type": "object",
  "properties": {
    "trade_proposal_id": {
      "type": "string"
    },
    "trade_id": {
      "type": "string",
      "description": "Links this review to a completed TradeProposal."
    },
    "business_id": {
      "type": "string",
      "description": "The BusinessProfile this review is about."
    },
    "creator_id": {
      "type": "string",
      "description": "The CreatorProfile who wrote (or is referenced by) this review."
    },
    "reviewer_id": {
      "type": "string"
    },
    "reviewer_name": {
      "type": "string"
    },
    "reviewer_type": {
      "type": "string",
      "enum": [
        "business",
        "creator"
      ]
    },
    "reviewee_id": {
      "type": "string"
    },
    "reviewee_type": {
      "type": "string",
      "enum": [
        "business",
        "creator"
      ]
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "text": {
      "type": "string",
      "description": "Review body text."
    },
    "comment": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs of images attached to the review."
    },
    "helpful_count": {
      "type": "number",
      "default": 0
    },
    "collab_title": {
      "type": "string"
    }
  },
  "required": [
    "reviewer_id",
    "reviewee_id",
    "rating",
    "business_id",
    "creator_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "data.reviewer_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.reviewer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.reviewer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}