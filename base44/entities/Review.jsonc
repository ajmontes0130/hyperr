{
  "name": "Review",
  "type": "object",
  "properties": {
    "trade_proposal_id": {
      "type": "string"
    },
    "reviewer_id": {
      "type": "string"
    },
    "reviewer_name": {
      "type": "string"
    },
    "reviewer_type": {
      "type": "string",
      "enum": [
        "business",
        "creator"
      ]
    },
    "reviewee_id": {
      "type": "string"
    },
    "reviewee_type": {
      "type": "string",
      "enum": [
        "business",
        "creator"
      ]
    },
    "rating": {
      "type": "number"
    },
    "comment": {
      "type": "string"
    },
    "collab_title": {
      "type": "string"
    }
  },
  "required": [
    "reviewer_id",
    "reviewee_id",
    "rating"
  ],
  "rls": {
    "read": {},
    "create": {
      "data.reviewer_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.reviewer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.reviewer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}