{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "account_type": {
      "type": "string",
      "description": "Whether the user onboarded as a creator or a business",
      "enum": [
        "creator",
        "business"
      ]
    },
    "is_suspended": {
      "type": "boolean",
      "default": false,
      "description": "Admin-set flag. When true, the user is suspended from the marketplace."
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}