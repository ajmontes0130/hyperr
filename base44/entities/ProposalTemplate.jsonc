{
  "name": "ProposalTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "Instagram",
        "TikTok",
        "YouTube",
        "Blog",
        "Podcast",
        "Twitter/X",
        "Newsletter",
        "Event",
        "Other"
      ]
    },
    "proposed_promotion": {
      "type": "string"
    },
    "audience_size": {
      "type": "string"
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "platform",
    "proposed_promotion",
    "message"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}