{
  "name": "Payment",
  "type": "object",
  "properties": {
    "cash_offer_id": {
      "type": "string"
    },
    "business_user_id": {
      "type": "string"
    },
    "business_name": {
      "type": "string"
    },
    "business_profile_id": {
      "type": "string"
    },
    "creator_user_id": {
      "type": "string"
    },
    "creator_name": {
      "type": "string"
    },
    "creator_profile_id": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "platform": {
      "type": "string",
      "enum": [
        "Instagram",
        "TikTok",
        "YouTube",
        "Blog",
        "Podcast",
        "Twitter/X",
        "Newsletter",
        "Event",
        "Other"
      ]
    },
    "deliverables": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "unfunded",
        "held",
        "delivered",
        "released",
        "refunded",
        "disputed"
      ],
      "default": "unfunded"
    },
    "stripe_session_id": {
      "type": "string"
    },
    "stripe_payment_intent_id": {
      "type": "string"
    },
    "stripe_charge_id": {
      "type": "string"
    },
    "stripe_transfer_id": {
      "type": "string"
    },
    "funded_date": {
      "type": "string",
      "format": "date-time"
    },
    "delivered_date": {
      "type": "string",
      "format": "date-time"
    },
    "released_date": {
      "type": "string",
      "format": "date-time"
    },
    "refunded_date": {
      "type": "string",
      "format": "date-time"
    },
    "delivery_note": {
      "type": "string"
    },
    "delivery_url": {
      "type": "string"
    },
    "dispute_reason": {
      "type": "string"
    }
  },
  "required": [
    "cash_offer_id",
    "business_user_id",
    "creator_user_id",
    "amount",
    "platform",
    "deliverables"
  ]
}