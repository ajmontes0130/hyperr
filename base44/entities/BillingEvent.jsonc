{
  "name": "BillingEvent",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "References the User this billing event belongs to."
    },
    "subscription_id": {
      "type": "string",
      "description": "References the Subscription this event is about."
    },
    "event_type": {
      "type": "string",
      "enum": [
        "subscription_created",
        "payment_succeeded",
        "payment_failed",
        "subscription_canceled",
        "subscription_renewed",
        "verification_approved"
      ]
    },
    "amount": {
      "type": "number",
      "description": "Amount in cents."
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "stripe_event_id": {
      "type": "string",
      "description": "Stripe event id for webhook matching."
    },
    "details": {
      "type": "string",
      "description": "JSON blob of extra info."
    }
  },
  "required": [
    "user_id",
    "event_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}