{
  "name": "CashOffer",
  "type": "object",
  "properties": {
    "creator_profile_id": {
      "type": "string"
    },
    "creator_user_id": {
      "type": "string"
    },
    "business_profile_id": {
      "type": "string"
    },
    "business_user_id": {
      "type": "string"
    },
    "business_name": {
      "type": "string"
    },
    "creator_name": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "platform": {
      "type": "string",
      "enum": [
        "Instagram",
        "TikTok",
        "YouTube",
        "Blog",
        "Podcast",
        "Twitter/X",
        "Newsletter",
        "Event",
        "Other"
      ]
    },
    "deliverables": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined",
        "completed"
      ],
      "default": "pending"
    }
  },
  "required": [
    "creator_profile_id",
    "amount",
    "platform",
    "deliverables"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.business_user_id": "{{user.id}}"
        },
        {
          "data.creator_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.business_user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.business_user_id": "{{user.id}}"
        },
        {
          "data.creator_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.business_user_id": "{{user.id}}"
        },
        {
          "data.creator_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}