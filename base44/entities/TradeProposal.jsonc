{
  "name": "TradeProposal",
  "type": "object",
  "properties": {
    "listing_id": {
      "type": "string"
    },
    "listing_title": {
      "type": "string"
    },
    "listing_owner_id": {
      "type": "string"
    },
    "proposer_id": {
      "type": "string"
    },
    "proposer_business_name": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "proposed_promotion": {
      "type": "string"
    },
    "audience_size": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "Instagram",
        "TikTok",
        "YouTube",
        "Blog",
        "Podcast",
        "Twitter/X",
        "Newsletter",
        "Event",
        "Other"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "in_progress",
        "proof_submitted",
        "delivered",
        "completed",
        "declined",
        "disputed"
      ],
      "default": "pending"
    },
    "creator_delivered": {
      "type": "boolean",
      "default": false
    },
    "business_confirmed": {
      "type": "boolean",
      "default": false
    },
    "disputed": {
      "type": "boolean",
      "default": false
    },
    "dispute_reason": {
      "type": "string"
    },
    "delivery_note": {
      "type": "string"
    },
    "delivery_url": {
      "type": "string"
    },
    "proof_image_url": {
      "type": "string",
      "description": "URL of the creator's uploaded proof image showing content delivery."
    },
    "proof_submitted_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the creator submitted proof of delivery."
    },
    "completed_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the trade was marked completed."
    },
    "business_notes": {
      "type": "string",
      "description": "Feedback / notes left by the business."
    },
    "creator_notes": {
      "type": "string",
      "description": "Feedback / notes left by the creator."
    }
  },
  "required": [
    "listing_id",
    "listing_owner_id",
    "message",
    "proposed_promotion",
    "platform"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.listing_owner_id": "{{user.id}}"
        },
        {
          "data.proposer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.proposer_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.listing_owner_id": "{{user.id}}"
        },
        {
          "data.proposer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.listing_owner_id": "{{user.id}}"
        },
        {
          "data.proposer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}